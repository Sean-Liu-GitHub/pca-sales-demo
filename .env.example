# Copy this file to .env and adjust values as needed
# cp .env.example .env

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=policy.sales.raw
KAFKA_DLQ_TOPIC=policy.sales.deadletter
KAFKA_GROUP_ID=policy-consumer-group

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pca_sales
POSTGRES_USER=pca
POSTGRES_PASSWORD=pca_secret

# Producer
PUBLISH_INTERVAL_SEC=2

# dbt
DBT_RUN_INTERVAL=60
